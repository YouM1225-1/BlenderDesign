+    def test_resolves_member_in_class_rst(self) -> None:
+        """
+        ``bpy.types.Scene.rst`` wraps members in ``.. class:: Scene``;
+        resolving a fully-qualified member must retain that container.
+        """
+        payload = _call_server_tool(
+            "get_python_api_docs",
+            {"identifier": "bpy.types.Scene.frame_current"},
+        )
+        self.assertEqual(payload["kind"], "definition")
+        self.assertTrue(payload["found"])
+        self.assertEqual(payload["identifier"], "bpy.types.Scene.frame_current")
+        self.assertIn(".. attribute:: frame_current", payload["content"])
