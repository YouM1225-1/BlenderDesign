@@ -45,6 +46,49 @@ from mcp import (  # pylint: disable=import-error,no-name-in-module
 # ---------------------------------------------------------------------------
 # OpenAI API helpers
 
+_HTTP_TIMEOUT_SECONDS = 30
+_MAX_HTTP_RESPONSE_BYTES = 16 * 1024 * 1024
+
+
+class _HTTPRedirectHandler(urllib.request.HTTPRedirectHandler):
+    """Reject redirects before urllib opens a non-HTTP(S) target."""
+
+    def redirect_request(
+        self,
+        req: urllib.request.Request,
+        fp: Any,
+        code: int,
+        msg: str,
+        headers: Any,
+        newurl: str,
+    ) -> urllib.request.Request | None:
+        if urllib.parse.urlsplit(newurl).scheme not in {"http", "https"}:
+            raise ValueError("API redirect must use HTTP or HTTPS")
+        return super().redirect_request(req, fp, code, msg, headers, newurl)
+
+
+_HTTP_OPENER = urllib.request.build_opener(_HTTPRedirectHandler())
+
+
+def _read_json_response(req: urllib.request.Request) -> dict[str, Any]:
+    """Open an HTTP(S) request and parse one bounded JSON object."""
+    if urllib.parse.urlsplit(req.full_url).scheme not in {"http", "https"}:
+        raise ValueError("API URL must use HTTP or HTTPS")
+    # Bandit cannot infer the explicit scheme and redirect checks.
+    with _HTTP_OPENER.open(  # nosec B310
+        req,
+        timeout=_HTTP_TIMEOUT_SECONDS,
+    ) as resp:
+        if urllib.parse.urlsplit(resp.geturl()).scheme not in {"http", "https"}:
+            raise ValueError("API redirect must use HTTP or HTTPS")
+        raw = resp.read(_MAX_HTTP_RESPONSE_BYTES + 1)
+    if len(raw) > _MAX_HTTP_RESPONSE_BYTES:
+        raise ValueError("API response exceeds size limit")
+    result = json.loads(raw.decode())
+    if type(result) is not dict:
+        raise ValueError("API response must be a JSON object")
+    return result
+
 def _api_chat_completions(
     api_url: str,
     messages: list[dict[str, Any]],
@@ -67,9 +111,7 @@ def _api_chat_completions(
