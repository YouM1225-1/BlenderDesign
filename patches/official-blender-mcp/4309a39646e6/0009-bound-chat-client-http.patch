+# SPDX-FileCopyrightText: 2026 Blender Authors
+#
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+"""Tests for bounded chat-client HTTP responses."""
+
+__all__ = ()
+
+import unittest
+from unittest import mock
+import urllib.request
+from pathlib import Path
+import sys
+
+sys.path.insert(0, str(Path(__file__).parents[1]))
+
+from chat_client import chat_client
+
+
+class _Response:
+    def __init__(self, content: bytes, url: str = "https://example.invalid/result") -> None:
+        self.content = content
+        self.url = url
+        self.read_size: int | None = None
+
+    def __enter__(self) -> "_Response":
+        return self
+
+    def __exit__(self, *_args: object) -> None:
+        return None
+
+    def geturl(self) -> str:
+        return self.url
+
+    def read(self, size: int) -> bytes:
+        self.read_size = size
+        return self.content[:size]
+
+
+class TestHTTPResponse(unittest.TestCase):
+    def test_rejects_non_http_url_without_opening_it(self) -> None:
+        req = urllib.request.Request("file:///tmp/response.json")
+        with (
+            mock.patch.object(urllib.request, "urlopen") as urlopen,
+            self.assertRaisesRegex(ValueError, "HTTP or HTTPS"),
+        ):
+            chat_client._read_json_response(req)  # type: ignore[attr-defined]
+        urlopen.assert_not_called()
+
+    def test_bounds_response_and_sets_timeout(self) -> None:
+        response = _Response(b'{"ok": true}')
+        req = urllib.request.Request("https://example.invalid")
+        with mock.patch.object(chat_client._HTTP_OPENER, "open", return_value=response) as open_url:  # type: ignore[attr-defined]
+            result = chat_client._read_json_response(req)  # type: ignore[attr-defined]
+        self.assertEqual(result, {"ok": True})
+        self.assertEqual(response.read_size, chat_client._MAX_HTTP_RESPONSE_BYTES + 1)  # type: ignore[attr-defined]
+        open_url.assert_called_once_with(req, timeout=chat_client._HTTP_TIMEOUT_SECONDS)  # type: ignore[attr-defined]
+
+    def test_rejects_oversized_response(self) -> None:
+        response = _Response(b"x" * (chat_client._MAX_HTTP_RESPONSE_BYTES + 1))  # type: ignore[attr-defined]
+        req = urllib.request.Request("https://example.invalid")
+        with (
+            mock.patch.object(chat_client._HTTP_OPENER, "open", return_value=response),  # type: ignore[attr-defined]
+            self.assertRaisesRegex(ValueError, "exceeds size limit"),
+        ):
+            chat_client._read_json_response(req)  # type: ignore[attr-defined]
+
+    def test_rejects_non_http_redirect(self) -> None:
+        response = _Response(b'{"ok": true}', "file:///tmp/response.json")
+        req = urllib.request.Request("https://example.invalid")
+        with (
+            mock.patch.object(chat_client._HTTP_OPENER, "open", return_value=response),  # type: ignore[attr-defined]
+            self.assertRaisesRegex(ValueError, "redirect"),
+        ):
+            chat_client._read_json_response(req)  # type: ignore[attr-defined]
+
+    def test_redirect_handler_rejects_non_http_before_opening_it(self) -> None:
+        handler = chat_client._HTTPRedirectHandler()  # type: ignore[attr-defined]
+        req = urllib.request.Request("https://example.invalid")
+        with self.assertRaisesRegex(ValueError, "redirect"):
+            handler.redirect_request(req, None, 302, "Found", {}, "file:///tmp/response.json")
+
+
+if __name__ == "__main__":
+    unittest.main()
