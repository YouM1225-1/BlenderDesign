 mcp/requirements_dev.txt                      |  2 +
 6 files changed, 33 insertions(+), 21 deletions(-)

diff --git a/Makefile b/Makefile
index 57f7b24..ab85a33 100644
--- a/Makefile
+++ b/Makefile
@@ -116,7 +116,7 @@ check_ascii:
 	@$(PYTHON) _misc/check_ascii.py
 
 check_mypy:
-	@! $(PYTHON) -m mypy --exclude 'data/api/examples/' $(PYTHON_SOURCE_DIRS_TO_CHECK) 2>&1 | grep -v '^stubs/' | grep ': error:' || \
+	@! $(PYTHON) -m mypy --config-file mcp/pyproject.toml --exclude 'data/api/examples/' $(PYTHON_SOURCE_DIRS_TO_CHECK) 2>&1 | grep -v '^stubs/' | grep ': error:' || \
 		{ echo "mypy: found errors"; exit 1; }
 
