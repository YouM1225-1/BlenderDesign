diff --git a/mcp/blmcp/mcp_compat.py b/mcp/blmcp/mcp_compat.py
new file mode 100644
index 0000000..1d1dcf9
--- /dev/null
+++ b/mcp/blmcp/mcp_compat.py
@@ -0,0 +1,77 @@
+# SPDX-FileCopyrightText: 2026 Blender Authors
+#
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+"""Compatibility boundary for the supported MCP SDK major versions."""
+
+__all__ = (
+    "MCP_V2",
+    "FastMCP",
+    "Image",
+    "MCPToolServer",
+    "TransportSecuritySettings",
+    "clean_doc",
+    "tool_annotations",
+)
+
+import importlib
+import inspect
+from collections.abc import Callable
+from typing import Protocol, TypeVar
+
+_ToolFunction = TypeVar("_ToolFunction", bound=Callable[..., object])
+
+
+class MCPToolServer(Protocol):
+    """The typed subset tool modules use from either MCP server class."""
+
+    def tool(
+        self,
+        **_kwargs: object,
+    ) -> Callable[[_ToolFunction], _ToolFunction]: ...
+
+
+try:
+    _server_module = importlib.import_module("mcp.server.fastmcp")
+except ModuleNotFoundError as ex:
+    if ex.name != "mcp.server.fastmcp":
+        raise
+
+    _server_module = importlib.import_module("mcp.server.mcpserver")
+    _security_module = importlib.import_module("mcp.server.transport_security")
+    _FastMCP = _server_module.MCPServer
+    _MCP_V2 = True
+else:
+    _security_module = importlib.import_module("mcp.server.fastmcp.server")
+    _FastMCP = _server_module.FastMCP
+    _MCP_V2 = False
+
+FastMCP = _FastMCP
+Image = _server_module.Image
+MCP_V2 = _MCP_V2
+TransportSecuritySettings = _security_module.TransportSecuritySettings
+
+
+def clean_doc(function: _ToolFunction) -> _ToolFunction:
+    """Make nested tool docstrings stable across supported Python versions."""
+    doc = inspect.cleandoc(function.__doc__ or "")
+    function.__doc__ = "\n{:s}\n".format(doc) if doc else ""
+    return function
+
+
+def tool_annotations(
+    *,
+    title: str,
+    read_only: bool | None = None,
+    destructive: bool | None = None,
+) -> object:
+    """Create tool annotations through field aliases shared by both SDK versions."""
+    data: dict[str, object] = {"title": title}
+    if read_only is not None:
+        data["readOnlyHint"] = read_only
+    if destructive is not None:
+        data["destructiveHint"] = destructive
+
+    types_module = importlib.import_module("mcp.types")
+    value: object = types_module.ToolAnnotations.model_validate(data)
+    return value
