From 18cb9a904a0fcf2418113d034913bcfc93f41d13 Mon Sep 17 00:00:00 2001
From: BlenderDesign Certification <noreply@example.invalid>
Date: Sun, 23 Aug 2026 17:26:45 +0800
Subject: [PATCH] Align upstream tests with certified behavior

Refresh the frozen tool-description catalog after the reviewed hardening changes and make the HTTP transport test exercise the explicit MCP 1.28/2.x compatibility boundary.
---
 tests/test_mcp_server.py   | 39 +++++++++++++++++++----------
 tests/test_tool_listing.py | 50 ++++++++++++++++++++++++++++----------
 2 files changed, 63 insertions(+), 26 deletions(-)

diff --git a/tests/test_mcp_server.py b/tests/test_mcp_server.py
index ad70774..b26f37a 100644
--- a/tests/test_mcp_server.py
+++ b/tests/test_mcp_server.py
@@ -681,8 +681,6 @@ class TestMainConfiguration(unittest.TestCase):
         mcp_instance.settings = types.SimpleNamespace()
         mcp_instance.streamable_http_app = mock.Mock(return_value=fake_app)
 
-        fastmcp_server_mod = types.ModuleType("mcp.server.fastmcp.server")
-        fastmcp_server_mod.TransportSecuritySettings = FakeTransportSecuritySettings
         starlette_apps_mod = types.ModuleType("starlette.applications")
         starlette_apps_mod.Starlette = object
         starlette_cors_mod = types.ModuleType("starlette.middleware.cors")
@@ -695,11 +693,15 @@ class TestMainConfiguration(unittest.TestCase):
                 ["blmcp", "--transport", "http", "--host", "0.0.0.0", "--port", "8123"],
             ),
             mock.patch.object(blmcp, "FastMCP", return_value=mcp_instance),
+            mock.patch.object(
+                blmcp,
+                "TransportSecuritySettings",
+                FakeTransportSecuritySettings,
+            ),
             mock.patch.object(blmcp.pkgutil, "iter_modules", return_value=[]),
             mock.patch.dict(
                 sys.modules,
                 {
-                    "mcp.server.fastmcp.server": fastmcp_server_mod,
                     "starlette.applications": starlette_apps_mod,
                     "starlette.middleware.cors": starlette_cors_mod,
                 },
@@ -708,19 +710,30 @@ class TestMainConfiguration(unittest.TestCase):
             result = blmcp.main()
 
         self.assertEqual(result, 0)
-        self.assertEqual(mcp_instance.settings.host, "0.0.0.0")
-        self.assertEqual(mcp_instance.settings.port, 8123)
-        self.assertEqual(mcp_instance.settings.streamable_http_path, "/")
-        self.assertTrue(mcp_instance.settings.stateless_http)
-        self.assertIsInstance(
-            mcp_instance.settings.transport_security,
-            FakeTransportSecuritySettings,
-        )
+        if blmcp.MCP_V2:
+            mcp_instance.run.assert_called_once_with(
+                transport="streamable-http",
+                host="0.0.0.0",
+                port=8123,
+                streamable_http_path="/",
+                stateless_http=True,
+                transport_security=mock.ANY,
+            )
+            transport_security = mcp_instance.run.call_args.kwargs[
+                "transport_security"
+            ]
+        else:
+            self.assertEqual(mcp_instance.settings.host, "0.0.0.0")
+            self.assertEqual(mcp_instance.settings.port, 8123)
+            self.assertEqual(mcp_instance.settings.streamable_http_path, "/")
+            self.assertTrue(mcp_instance.settings.stateless_http)
+            mcp_instance.run.assert_called_once_with(transport="streamable-http")
+            transport_security = mcp_instance.settings.transport_security
+        self.assertIsInstance(transport_security, FakeTransportSecuritySettings)
         self.assertEqual(
-            mcp_instance.settings.transport_security.kwargs,
+            transport_security.kwargs,
             {"enable_dns_rebinding_protection": False},
         )
-        mcp_instance.run.assert_called_once_with(transport="streamable-http")
 
         app = mcp_instance.streamable_http_app()
         self.assertIs(app, fake_app)
