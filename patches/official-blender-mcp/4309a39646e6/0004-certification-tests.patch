@@ -172,7 +183,8 @@ EXPECTED_TOOLS = [
     {
         "name": "get_blendfile_summary_path_info_for_cli",
         "description": "\n"
-        "Return path info by opening *blend_file* in background Blender.\n",
+        "Return path info by opening *blend_file* in background Blender.\n"
+        "This reads the on-disk file and does not include unsaved changes from a running Blender instance.\n",
         "inputSchema": {
