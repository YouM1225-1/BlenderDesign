+def _close_connection(conn: socket.socket) -> None:
+    """Close one accepted interactive connection and release its slot."""
+    _close_socket(conn)
+    _state.connection_count = max(0, _state.connection_count - 1)
+
+
+def _close_socket(conn: socket.socket) -> None:
+    """Close a socket without changing accepted-connection accounting."""
+    try:
+        conn.close()
+    except OSError:
+        pass
+
+
+def _queue_response(client: _Client, response: dict[str, object]) -> None:
+    """Queue one response for non-blocking writes."""
+    client.buffer.clear()
+    client.response = _encode_response(response)
+    client.response_offset = 0
+    client.timeout = _timer.client_timeout_countdown
+
+
+def _queue_response_for_connection(
+        conn: socket.socket, response: dict[str, object],
+) -> None:
+    """Return a deferred connection to the main non-blocking write queue."""
+    client = _Client(conn)
+    _queue_response(client, response)
+    _state.clients.append(client)
+
+
+def _flush_client_response(client: _Client, send_budget: int) -> int:
+    """Write within one client's budget, returning the byte count sent."""
+    assert client.response is not None
+    chunk = client.response[
+        client.response_offset:client.response_offset + min(_SEND_CHUNK_SIZE, send_budget)
+    ]
+    try:
+        sent = client.conn.send(chunk)
+    except BlockingIOError:
+        return 0
+    except OSError:
+        _close_client(client)
+        return 0
+    if sent <= 0:
+        _close_client(client)
+        return 0
+    client.response_offset += sent
+    client.timeout = _timer.client_timeout_countdown
+    if client.response_offset == len(client.response):
+        _close_client(client)
+    return sent
+
+
