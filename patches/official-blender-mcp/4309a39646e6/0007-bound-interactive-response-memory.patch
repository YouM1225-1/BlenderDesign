@@ -23,6 +23,7 @@ _DEFAULT_HOST = "localhost"
 _DEFAULT_PORT = 9876
 _TIMEOUT = 120.0
 _RECV_BUFFER_SIZE = 65536
+_MAX_RESPONSE_BYTES = 10 * 1024 * 1024
 
 
 class BlenderUnavailableError(ConnectionError):
