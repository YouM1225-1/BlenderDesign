+                        )
+                    )
             _remaining_timeout(deadline)
         except TimeoutError as ex:
             raise ConnectionError(
                 "Blender response timed out at {:s}:{:d}".format(host, port)
             ) from ex
+        except ConnectionError:
+            raise
         except OSError as ex:
             raise ConnectionError(
                 "Socket error after connecting to Blender at {:s}:{:d}: {:s}".format(
@@ -114,7 +130,9 @@ def send_code(
         raise ConnectionError("Empty response from Blender")
 
     # Parse only up to the first null byte delimiter.
-    line, _sep, _rest = buf.partition(b"\0")
+    line, sep, _rest = buf.partition(b"\0")
+    if not sep:
+        raise ConnectionError("Blender response is missing the null-byte delimiter")
     try:
         response: dict[str, object] = json.loads(line.decode("utf-8"))
     except (json.JSONDecodeError, UnicodeDecodeError) as ex:
diff --git a/tests/test_transport_limits.py b/tests/test_transport_limits.py
new file mode 100644
index 0000000..5e6cbce
--- /dev/null
+++ b/tests/test_transport_limits.py
@@ -0,0 +1,106 @@
+# SPDX-FileCopyrightText: 2026 Blender Authors
+#
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+from __future__ import annotations
+
+import importlib.util
+import io
+import json
+import unittest
+from pathlib import Path
+from types import ModuleType
+from typing import Self
+from unittest import mock
+
+from blmcp.tools_helpers import connection
+
+ROOT = Path(__file__).parents[1]
+
+
+def _load(name: str, path: Path) -> ModuleType:
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+class _Sink(io.TextIOBase):
+    def write(self, value: str) -> int:
+        return len(value)
+
+
+class _Socket:
+    def __init__(self, chunks: list[bytes]) -> None:
+        self._chunks = chunks
+
+    def __enter__(self) -> Self:
+        return self
+
+    def __exit__(self, *_args: object) -> None:
+        pass
+
+    def settimeout(self, _timeout: float) -> None:
+        pass
+
+    def connect(self, _address: tuple[str, int]) -> None:
+        pass
+
+    def sendall(self, _request: bytes) -> None:
+        pass
+
+    def recv(self, _size: int) -> bytes:
+        return self._chunks.pop(0)
+
+
+class TestTransportLimits(unittest.TestCase):
+    def test_addon_bounds_captured_output_and_serialized_response(self) -> None:
+        capture = _load(
+            "capture_output_for_test",
+            ROOT / "addon/blender_mcp_addon/capture_output.py",
+        )
+        with mock.patch.object(capture, "_MAX_CAPTURE_CHARS", 8):
+            tee = capture._Tee(_Sink())
+            self.assertEqual(tee.write("0123456789"), 10)
+            self.assertTrue(tee.getvalue().startswith("01234567\n[output truncated"))
+
+        server = _load(
+            "mcp_to_blender_server_for_test",
+            ROOT / "addon/blender_mcp_addon/mcp_to_blender_server.py",
+        )
+        with mock.patch.object(server, "_MAX_RESPONSE_BYTES", 128):
+            encoded = server._encode_response({"status": "ok", "result": "x" * 256})
+        self.assertTrue(encoded.endswith(b"\0"))
+        self.assertLessEqual(len(encoded), 129)
+        self.assertEqual(json.loads(encoded[:-1])["status"], "error")
+
+    def test_client_rejects_oversized_or_unframed_response(self) -> None:
+        with (
+            mock.patch.object(connection, "_MAX_RESPONSE_BYTES", 32),
+            mock.patch.object(
+                connection.socket,
+                "socket",
+                side_effect=lambda *_args: _Socket([b"x" * 33]),
+            ),
+            self.assertRaisesRegex(ConnectionError, "exceeds 32 byte limit"),
+        ):
+            connection.send_code("result = {}", strict_json=True)
+
+        with (
+            mock.patch.object(
+                connection.socket,
+                "socket",
+                side_effect=lambda *_args: _Socket(
+                    [b'{"status":"ok","result":{}}', b""]
+                ),
+            ),
+            self.assertRaisesRegex(
+                ConnectionError, "missing the null-byte delimiter"
+            ),
+        ):
+            connection.send_code("result = {}", strict_json=True)
+
+
+if __name__ == "__main__":
+    unittest.main()
