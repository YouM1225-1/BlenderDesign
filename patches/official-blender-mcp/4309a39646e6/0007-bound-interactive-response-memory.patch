From 8573b252d32527b3467d914646f74624cde19c6e Mon Sep 17 00:00:00 2001
From: BlenderDesign Certification <noreply@example.invalid>
Date: Sun, 23 Aug 2026 17:49:29 +0800
Subject: [PATCH] Bound interactive response memory

Cap captured output, serialized responses, and client receive buffers; reject oversized or unterminated live transport frames.
---
 Makefile                                      |   1 +
 addon/blender_mcp_addon/capture_output.py     |  14 ++-
 .../mcp_to_blender_server.py                  |   9 +-
 mcp/blmcp/tools_helpers/connection.py         |  22 +++-
 tests/test_transport_limits.py                | 106 ++++++++++++++++++
 5 files changed, 147 insertions(+), 5 deletions(-)
 create mode 100644 tests/test_transport_limits.py

diff --git a/Makefile b/Makefile
index ab85a33..de31f2d 100644
--- a/Makefile
+++ b/Makefile
@@ -89,6 +89,7 @@ test:
 	$(PYTHON) tests/test_rst_parse.py
 	$(PYTHON) tests/test_rst_search.py
 	$(PYTHON) tests/test_mcp_server.py
+	$(PYTHON) tests/test_transport_limits.py
 	$(PYTHON) tests/test_blender_mcp_with_blender.py
 
 test_rst_parse:
diff --git a/addon/blender_mcp_addon/capture_output.py b/addon/blender_mcp_addon/capture_output.py
index 7d0e73b..f102a43 100644
--- a/addon/blender_mcp_addon/capture_output.py
+++ b/addon/blender_mcp_addon/capture_output.py
@@ -17,6 +17,8 @@ import sys
 from typing import IO, TypeVar
 
 _CaptureOutputT = TypeVar("_CaptureOutputT", bound="CaptureOutput")
+_MAX_CAPTURE_CHARS = 1024 * 1024
+_TRUNCATED = "\n[output truncated at {:d} characters]".format(_MAX_CAPTURE_CHARS)
 
 
 class _Tee(io.TextIOBase):
@@ -24,22 +26,30 @@ class _Tee(io.TextIOBase):
     __slots__ = (
         "_buffer",
         "_original",
+        "_truncated",
     )
 
     def __init__(self, original: IO[str]) -> None:
         self._buffer = io.StringIO()
         self._original = original
+        self._truncated = False
 
     def write(self, s: str) -> int:
         self._original.write(s)
-        return self._buffer.write(s)
+        remaining = _MAX_CAPTURE_CHARS - self._buffer.tell()
+        if remaining > 0:
+            self._buffer.write(s[:remaining])
+        if len(s) > remaining:
+            self._truncated = True
+        return len(s)
 
     def flush(self) -> None:
         self._original.flush()
         self._buffer.flush()
 
     def getvalue(self) -> str:
-        return self._buffer.getvalue()
+        value = self._buffer.getvalue()
+        return value + _TRUNCATED if self._truncated else value
 
 
 class CaptureOutput:
diff --git a/addon/blender_mcp_addon/mcp_to_blender_server.py b/addon/blender_mcp_addon/mcp_to_blender_server.py
index 125afbc..cc1c8ca 100644
--- a/addon/blender_mcp_addon/mcp_to_blender_server.py
+++ b/addon/blender_mcp_addon/mcp_to_blender_server.py
@@ -125,6 +125,7 @@ def timer_idle_interval() -> float:
 use_log: bool = False
 
 _MAX_REQUEST_BYTES = 10 * 1024 * 1024  # 10 MiB.
+_MAX_RESPONSE_BYTES = 10 * 1024 * 1024  # 10 MiB, excluding the delimiter.
 # Maximum number of queued incoming connections.
 _LISTEN_BACKLOG = 5
 _MAX_CLIENTS = 16
@@ -217,7 +218,13 @@ def _encode_response(response: dict[str, object]) -> bytes:
     """
     Serialize a response dict as null-byte-delimited JSON bytes.
     """
-    return (json.dumps(response) + "\0").encode("utf-8")
+    encoded = json.dumps(response).encode("utf-8")
+    if len(encoded) > _MAX_RESPONSE_BYTES:
+        encoded = json.dumps({
+            "status": "error",
+            "message": "Response exceeds {:d} byte limit".format(_MAX_RESPONSE_BYTES),
+        }).encode("utf-8")
+    return encoded + b"\0"
 
 
 def _execute_code(
