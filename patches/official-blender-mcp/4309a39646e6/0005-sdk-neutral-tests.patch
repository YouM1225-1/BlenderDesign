From 584f31f095fac0c986179cbf379aa2963b68440d Mon Sep 17 00:00:00 2001
From: BlenderDesign Certification <noreply@example.invalid>
Date: Sun, 23 Aug 2026 17:30:43 +0800
Subject: [PATCH] Make certification clients SDK-version neutral

Read the MCP 1.28 camelCase and MCP 2.x snake_case result fields through one explicit test boundary so the same functional suite certifies both supported SDK generations.
---
 tests/test_mcp_server.py   | 17 ++++++++++++++---
 tests/test_tool_listing.py |  6 +++++-
 2 files changed, 19 insertions(+), 4 deletions(-)

diff --git a/tests/test_mcp_server.py b/tests/test_mcp_server.py
index b26f37a..e18fb2c 100644
--- a/tests/test_mcp_server.py
+++ b/tests/test_mcp_server.py
@@ -109,6 +109,13 @@ def _server_env() -> dict[str, str]:
     return env
 
 
+def _sdk_field(value: object, camel_case: str, snake_case: str) -> object:
+    try:
+        return getattr(value, camel_case)
+    except AttributeError:
+        return getattr(value, snake_case)
+
+
 def _query_server() -> dict[str, Any]:
     """
     Launch the MCP server, initialize, fetch metadata, and return it all.
@@ -126,13 +133,17 @@ def _query_server() -> dict[str, Any]:
                 init_result = await session.initialize()
                 tools_result = await session.list_tools()
                 return {
-                    "server_info": init_result.serverInfo,
+                    "server_info": _sdk_field(
+                        init_result, "serverInfo", "server_info"
+                    ),
                     "instructions": init_result.instructions or "",
                     "tools": [
                         {
                             "name": t.name,
                             "description": t.description or "",
-                            "inputSchema": t.inputSchema,
+                            "inputSchema": _sdk_field(
+                                t, "inputSchema", "input_schema"
+                            ),
                         }
                         for t in tools_result.tools
                     ],
@@ -158,7 +169,7 @@ def _call_server_tool(name: str, arguments: dict[str, object]) -> dict[str, Any]
             async with ClientSession(read, write) as session:
                 await session.initialize()
                 call_result = await session.call_tool(name, arguments)
-                if call_result.isError:
+                if _sdk_field(call_result, "isError", "is_error"):
                     raise RuntimeError(
                         "Tool {:s} returned error: {!r}".format(name, call_result.content)
                     )
diff --git a/tests/test_tool_listing.py b/tests/test_tool_listing.py
index 8266a44..5290c9f 100644
--- a/tests/test_tool_listing.py
+++ b/tests/test_tool_listing.py
@@ -700,7 +700,11 @@ def _list_tools() -> list[dict[str, object]]:
                     {
                         "name": t.name,
                         "description": t.description,
-                        "inputSchema": t.inputSchema,
+                        "inputSchema": (
+                            t.inputSchema
+                            if hasattr(t, "inputSchema")
+                            else t.input_schema
+                        ),
                     }
                     for t in result.tools
                 ]
-- 
